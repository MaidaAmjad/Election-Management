# Supabase — Election Management
# Copy this file to `.env` and paste your values from:
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public app URL for email links and redirects (do NOT put Brevo API key in Vite env)
# Vercel: set to https://your-project.vercel.app (required at build time in Vercel env vars)
VITE_APP_URL=http://localhost:5173

# Local scripts only — never commit
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Brevo (set the same values in Supabase Edge Function secrets for production)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
NOTIFICATION_FROM_EMAIL=Election Management <noreply@your-verified-domain.com>
APP_URL=http://localhost:5173
